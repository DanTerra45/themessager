<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
    <Compile Include="..\Application\Options\**\*.cs" Exclude="..\Application\bin\**\*.cs;..\Application\obj\**\*.cs" />
    <Compile Include="..\Application\utils\PasswordUtils.cs" />
    <Compile Include="..\Infrastructure\Options\BaseQueryOptions.cs" Exclude="..\Infrastructure\bin\**\*.cs;..\Infrastructure\obj\**\*.cs" />
  </ItemGroup>

</Project>
