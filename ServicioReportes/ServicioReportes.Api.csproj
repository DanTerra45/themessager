<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6f37c678-6f38-4c98-b890-1b4d22d94d11</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Application\ServicioReportes.Application.csproj" />
    <ProjectReference Include="Infrastructure\ServicioReportes.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Application\**\*.cs" />
    <Compile Remove="Domain\**\*.cs" />
    <Compile Remove="Infrastructure\**\*.cs" />
    <None Include="Application\**\*" />
    <None Include="Domain\**\*" />
    <None Include="Infrastructure\**\*" />
  </ItemGroup>
</Project>
