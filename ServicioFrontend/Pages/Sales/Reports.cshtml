@section Scripts {
    <script>
        (() => {
            const previewFlagKey = "mercadito:open-daily-cash-closing-preview";
            const dateForm = document.querySelector("[data-reports-date-form]");
            const dateInput = document.getElementById("businessDate");
            const dailyPreviewModalElement = document.getElementById("dailyCashClosingPreviewModal");

            const openModal = modalElement => {
                if (!modalElement || !window.bootstrap) {
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            };

            const shouldOpenPreview = sessionStorage.getItem(previewFlagKey) === "1";
            if (shouldOpenPreview) {
                sessionStorage.removeItem(previewFlagKey);
                openModal(dailyPreviewModalElement);
            }

            dateForm?.addEventListener("submit", event => {
                if (!dailyPreviewModalElement) {
                    return;
                }

                const selectedDate = dateInput?.value ?? "";
                const currentDate = dateForm.dataset.currentBusinessDate ?? "";
                if (selectedDate === currentDate) {
                    event.preventDefault();
                    openModal(dailyPreviewModalElement);
                    return;
                }

                sessionStorage.setItem(previewFlagKey, "1");
            });

            const closeReportSelects = except => {
                document.querySelectorAll("[data-reports-select]").forEach(select => {
                    if (select === except) {
                        return;
                    }

                    select.classList.remove("is-open");
                    select.querySelector("[data-reports-select-trigger]")?.setAttribute("aria-expanded", "false");
                });
            };

            document.querySelectorAll("[data-reports-select]").forEach(select => {
                const trigger = select.querySelector("[data-reports-select-trigger]");
                const valueInput = select.querySelector("[data-reports-select-value]");
                const label = select.querySelector("[data-reports-select-label]");

                trigger?.addEventListener("click", () => {
                    const willOpen = !select.classList.contains("is-open");
                    closeReportSelects(select);
                    select.classList.toggle("is-open", willOpen);
                    trigger.setAttribute("aria-expanded", String(willOpen));
                });

                select.querySelectorAll("[data-value]").forEach(option => {
                    option.addEventListener("click", () => {
                        if (valueInput) {
                            valueInput.value = option.dataset.value ?? "";
                        }

                        if (label) {
                            label.textContent = option.textContent?.trim() ?? "";
                        }

                        select.querySelectorAll("[data-value]").forEach(item => item.classList.remove("is-selected"));
                        option.classList.add("is-selected");
                        closeReportSelects();
                    });
                });
            });

            document.addEventListener("click", event => {
                if (!event.target.closest("[data-reports-select]")) {
                    closeReportSelects();
                }
            });

            document.addEventListener("keydown", event => {
                if (event.key === "Escape") {
                    closeReportSelects();
                }
            });

            document.querySelectorAll("[data-report-print-button]").forEach(button => {
                button.addEventListener("click", () => {
                    const targetId = button.getAttribute("data-report-print-button");
                    const targetModal = document.getElementById(targetId);
                    if (!targetModal) {
                        return;
                    }

                    document.querySelectorAll(".reports-preview-modal").forEach(modal => {
                        modal.classList.remove("is-report-print-source");
                    });

                    targetModal.classList.add("is-report-print-source");
                    openModal(targetModal);
                    window.setTimeout(() => window.print(), 180);
                });
            });

            window.addEventListener("afterprint", () => {
                document.querySelectorAll(".reports-preview-modal").forEach(modal => {
                    modal.classList.remove("is-report-print-source");
                });
            });
        })();
    </script>
}
