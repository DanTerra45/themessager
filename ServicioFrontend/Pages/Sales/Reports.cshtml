@page "/Sales/Reports"
@model ServicioFrontend.Pages.Sales.ReportsModel
@{
    ViewData["Title"] = "Reportes de ventas";
    var businessDateValue = Model.BusinessDate.ToString("yyyy-MM-dd");
    var fromDateValue = Model.FromDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var toDateValue = Model.ToDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var statusLabel = string.IsNullOrWhiteSpace(Model.StatusFilter) ? "Todos" : Model.StatusFilter;
    var paymentMethodLabel = string.IsNullOrWhiteSpace(Model.PaymentMethodFilter) ? "Todos" : Model.PaymentMethodFilter;
    var allStatusOptionClass = string.IsNullOrWhiteSpace(Model.StatusFilter) ? "reports-select-option is-selected" : "reports-select-option";
    var allPaymentMethodOptionClass = string.IsNullOrWhiteSpace(Model.PaymentMethodFilter) ? "reports-select-option is-selected" : "reports-select-option";
    var canCloseDailyCash = User.IsInRole("Admin") || User.IsInRole("Operator") || User.IsInRole("Operador");
}

@section Styles {
    <style>
        .reports-toolbar .form-control,
        .reports-filter-card .form-control,
        .reports-select-trigger {
            min-height: var(--mrc-control-height);
            height: var(--mrc-control-height);
            border: 2px solid var(--mrc-ink);
            border-radius: 0;
            box-shadow: none;
        }

        .reports-date-form .b-btn,
        .reports-toolbar > .b-btn,
        .reports-filter-card .b-btn {
            min-height: var(--mrc-control-height);
            height: var(--mrc-control-height);
        }

        .reports-filter-card {
            border: 2px solid var(--mrc-ink);
            box-shadow: 4px 4px 0 var(--mrc-ink);
            background: var(--mrc-surface);
        }

        .reports-select-menu {
            position: relative;
            z-index: 2;
        }

        .reports-select-menu.is-open {
            z-index: 20;
        }

        .reports-select-trigger {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.45rem 0.75rem;
            background: #fff;
            color: var(--mrc-ink);
            font-family: var(--font-body);
            text-align: left;
        }

        .reports-select-trigger:focus,
        .reports-select-trigger:active {
            outline: none;
            box-shadow: none;
            transform: none;
        }

        .reports-select-options {
            position: absolute;
            top: calc(100% - 2px);
            left: 0;
            right: 0;
            display: none;
            background: #fff;
            border: 2px solid var(--mrc-ink);
            box-shadow: 4px 4px 0 var(--mrc-ink);
            max-height: 13rem;
            overflow-y: auto;
        }

        .reports-select-menu.is-open .reports-select-options {
            display: grid;
        }

        .reports-select-option {
            width: 100%;
            border: 0;
            border-bottom: 1px solid var(--mrc-ink);
            background: #fff;
            color: var(--mrc-ink);
            padding: 0.65rem 0.75rem;
            text-align: left;
            font-family: var(--font-body);
        }

        .reports-select-option:last-child {
            border-bottom: 0;
        }

        .reports-select-option:hover,
        .reports-select-option:focus,
        .reports-select-option.is-selected {
            background: #d8fff7;
            outline: none;
        }

        .reports-preview-dialog {
            max-width: min(1180px, calc(100vw - 2rem));
        }

        .reports-preview-modal .modal-body {
            background-color: var(--mrc-surface);
        }

        .reports-preview-modal .reports-print-area {
            margin: 0;
        }

        .reports-logo {
            width: 64px;
            height: 64px;
            object-fit: contain;
        }

        .reports-document-heading {
            border-bottom: 2px solid var(--mrc-ink);
        }

        .reports-document-meta {
            min-width: 12rem;
            display: grid;
            gap: 0.35rem;
            text-align: right;
            font-family: var(--font-mono);
        }

        .reports-document-meta strong {
            display: block;
        }

        .reports-chart-list {
            display: grid;
            gap: 0.75rem;
        }

        .reports-chart-row {
            display: grid;
            grid-template-columns: minmax(155px, 1.1fr) minmax(180px, 2fr) minmax(95px, auto);
            gap: 0.75rem;
            align-items: center;
        }

        .reports-chart-track {
            height: 1.25rem;
            border: 2px solid var(--mrc-ink);
            background: #fff;
            overflow: hidden;
        }

        .reports-chart-bar-fill {
            display: block;
            height: 100%;
            min-width: 0.35rem;
            background: var(--mrc-accent);
        }

        .reports-chart-value {
            text-align: right;
            white-space: nowrap;
        }

        @@media (max-width: 991.98px) {
            .reports-toolbar,
            .reports-date-form {
                flex-wrap: wrap;
                justify-content: flex-end;
            }

            .reports-chart-row {
                grid-template-columns: 1fr;
            }
        }

        @@media print {
            @@page {
                size: A4 portrait;
                margin: 10mm;
            }

            *,
            *::before,
            *::after {
                print-color-adjust: exact !important;
                -webkit-print-color-adjust: exact !important;
            }

            body {
                background: #ffffff !important;
            }

            body > header,
            footer,
            .dash-header,
            .toast-container,
            main > .row,
            main > .reports-filter-card,
            main > .sales-history-card,
            .reports-preview-modal:not(.is-report-print-source),
            .reports-preview-modal .modal-header,
            .reports-preview-modal .modal-footer,
            .modal-backdrop {
                display: none !important;
            }

            main.container {
                display: block !important;
                max-width: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .reports-preview-modal.is-report-print-source,
            .reports-preview-modal.is-report-print-source .modal-dialog,
            .reports-preview-modal.is-report-print-source .modal-content,
            .reports-preview-modal.is-report-print-source .modal-body {
                display: block !important;
                position: static !important;
                width: auto !important;
                max-width: none !important;
                height: auto !important;
                max-height: none !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: visible !important;
                transform: none !important;
                background: #ffffff !important;
                border: 0 !important;
                box-shadow: none !important;
                opacity: 1 !important;
            }

            .reports-print-area,
            .reports-print-area .b-card,
            .reports-print-area .b-card-static {
                box-shadow: none !important;
                transform: none !important;
            }

            .reports-print-area {
                border: 2px solid var(--mrc-ink) !important;
                width: 100% !important;
                max-width: 190mm !important;
                margin: 0 auto !important;
                font-size: 0.82rem !important;
            }

            .reports-print-area .p-4 {
                padding: 0.85rem !important;
            }

            .reports-print-area .reports-logo {
                width: 46px !important;
                height: 46px !important;
            }

            .reports-print-area h2 {
                font-size: 1.45rem !important;
            }

            .reports-print-area .row {
                --bs-gutter-x: 0.65rem;
                --bs-gutter-y: 0.65rem;
            }

            .reports-chart-row,
            .reports-print-area .row.mb-4 > section,
            .reports-print-area tr {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }

            .reports-print-area thead {
                display: table-header-group !important;
            }

            .reports-print-area .table > :not(caption) > * > * {
                padding: 0.35rem 0.45rem !important;
            }

            .reports-print-area .reports-chart-list {
                gap: 0.4rem !important;
                padding: 0.55rem !important;
            }

            .reports-print-area .reports-chart-row {
                grid-template-columns: minmax(140px, 1.1fr) minmax(150px, 2fr) minmax(80px, auto) !important;
                gap: 0.45rem !important;
            }

            .reports-print-area .reports-chart-track {
                height: 0.8rem !important;
                border-width: 1px !important;
            }

            .reports-print-area .reports-chart-bar-fill {
                background: var(--mrc-accent) !important;
            }
        }
    </style>
}

<header class="dash-header d-flex justify-content-between align-items-end">
    <section>
        <h1>@ViewData["Title"]</h1>
        <p class="mb-0 text-muted" style="font-family: var(--font-mono);">Comprobantes y consulta operativa de ventas registradas</p>
    </section>
    <div class="d-flex gap-2 align-items-end reports-toolbar">
        @if (canCloseDailyCash)
        {
            <form method="get"
                  class="d-flex gap-2 align-items-end reports-date-form"
                  data-reports-date-form
                  data-current-business-date="@businessDateValue">
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                <input type="hidden" name="fromDate" value="@fromDateValue" />
                <input type="hidden" name="toDate" value="@toDateValue" />
                <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                <input type="hidden" name="paymentMethodFilter" value="@Model.PaymentMethodFilter" />
                <section>
                    <label for="businessDate" class="form-label mb-1" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Fecha cierre</label>
                    <input id="businessDate" name="businessDate" type="date" class="form-control" value="@businessDateValue" />
                </section>
                <button type="submit" class="b-btn b-btn-secondary text-decoration-none" aria-controls="dailyCashClosingPreviewModal">
                    <i class="bi bi-cash-coin"></i> Cerrar caja
                </button>
            </form>
        }
        <a asp-page="/Sales/Reports"
           asp-route-businessDate="@businessDateValue"
           asp-route-sortBy="@Model.SortBy"
           asp-route-sortDirection="@Model.SortDirection"
           asp-route-fromDate="@fromDateValue"
           asp-route-toDate="@toDateValue"
           asp-route-statusFilter="@Model.StatusFilter"
           asp-route-paymentMethodFilter="@Model.PaymentMethodFilter"
           class="b-btn b-btn-secondary listing-icon-btn dash-header-icon-btn text-decoration-none"
           title="Refrescar reportes de ventas"
           aria-label="Refrescar reportes de ventas">
            <i class="bi bi-arrow-clockwise"></i>
        </a>
    </div>
</header>

@if (Model.Errors.Count > 0)
{
    <section class="toast-container position-fixed bottom-0 end-0 p-3 app-toast-container" aria-live="polite" aria-atomic="true">
        <section class="toast align-items-center border-0 app-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="7000">
            <section class="d-flex position-relative">
                <section class="toast-icon d-flex align-items-center justify-content-center app-toast-icon app-toast-icon-error">
                    <i class="bi bi-exclamation-lg"></i>
                </section>
                <section class="toast-body app-toast-body">
                    <strong>No se pudo cargar toda la información de reportes.</strong>
                    <ul class="mb-0 mt-2">
                        @foreach (var error in Model.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </section>
                <button type="button" class="btn-close me-2 m-auto position-absolute top-0 end-0 mt-2 app-toast-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </section>
        </section>
    </section>
}

<section class="row g-3 mb-4">
    <section class="col-md-4">
        <article class="b-card h-100 p-3">
            <h2 style="font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; margin: 0 0 0.5rem 0;">Comprobantes disponibles</h2>
            <p style="font-family: var(--font-display); font-size: 2rem; margin: 0;">@Model.RegisteredSalesCount</p>
            <small class="text-muted">Ventas registradas con comprobante consultable</small>
        </article>
    </section>
    <section class="col-md-4">
        <article class="b-card h-100 p-3">
            <h2 style="font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; margin: 0 0 0.5rem 0;">Ventas anuladas</h2>
            <p style="font-family: var(--font-display); font-size: 2rem; margin: 0;">@Model.CancelledSalesCount</p>
            <small class="text-muted">Operaciones anuladas visibles en el historial</small>
        </article>
    </section>
    <section class="col-md-4">
        <article class="b-card h-100 p-3">
            <h2 style="font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; margin: 0 0 0.5rem 0;">Monto reportado</h2>
            <p style="font-family: var(--font-display); font-size: 2rem; margin: 0;">@Model.RegisteredAmountTotal.ToString("N2") Bs.</p>
            <small class="text-muted">Total acumulado de ventas registradas en el historial cargado</small>
        </article>
    </section>
</section>

<section class="reports-filter-card p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <input type="hidden" name="businessDate" value="@businessDateValue" />
        <input type="hidden" name="sortBy" value="@Model.SortBy" />
        <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
        <section class="col-sm-6 col-lg-2">
            <label for="fromDate" class="form-label mb-1" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Desde</label>
            <input id="fromDate" name="fromDate" type="date" class="form-control" value="@fromDateValue" />
        </section>
        <section class="col-sm-6 col-lg-2">
            <label for="toDate" class="form-label mb-1" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Hasta</label>
            <input id="toDate" name="toDate" type="date" class="form-control" value="@toDateValue" />
        </section>
        <section class="col-sm-6 col-lg-2">
            <label for="statusFilterTrigger" class="form-label mb-1" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Estado</label>
            <section class="reports-select-menu" data-reports-select>
                <input id="statusFilter" type="hidden" name="statusFilter" value="@Model.StatusFilter" data-reports-select-value />
                <button id="statusFilterTrigger" type="button" class="reports-select-trigger" data-reports-select-trigger aria-expanded="false">
                    <span data-reports-select-label>@statusLabel</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <section class="reports-select-options" data-reports-select-options>
                    <button type="button" class="@allStatusOptionClass" data-value="">Todos</button>
                    @foreach (var status in Model.StatusOptions)
                    {
                        var statusOptionClass = string.Equals(Model.StatusFilter, status, StringComparison.Ordinal) ? "reports-select-option is-selected" : "reports-select-option";
                        <button type="button" class="@statusOptionClass" data-value="@status">@status</button>
                    }
                </section>
            </section>
        </section>
        <section class="col-sm-6 col-lg-2">
            <label for="paymentMethodFilterTrigger" class="form-label mb-1" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Método</label>
            <section class="reports-select-menu" data-reports-select>
                <input id="paymentMethodFilter" type="hidden" name="paymentMethodFilter" value="@Model.PaymentMethodFilter" data-reports-select-value />
                <button id="paymentMethodFilterTrigger" type="button" class="reports-select-trigger" data-reports-select-trigger aria-expanded="false">
                    <span data-reports-select-label>@paymentMethodLabel</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <section class="reports-select-options" data-reports-select-options>
                    <button type="button" class="@allPaymentMethodOptionClass" data-value="">Todos</button>
                    @foreach (var paymentMethod in Model.PaymentMethodOptions)
                    {
                        var paymentMethodOptionClass = string.Equals(Model.PaymentMethodFilter, paymentMethod, StringComparison.Ordinal) ? "reports-select-option is-selected" : "reports-select-option";
                        <button type="button" class="@paymentMethodOptionClass" data-value="@paymentMethod">@paymentMethod</button>
                    }
                </section>
            </section>
        </section>
        <section class="col-sm-6 col-lg-2 d-grid">
            <button type="submit" class="b-btn">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
        </section>
        <section class="col-sm-6 col-lg-2 d-grid">
            <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection" class="b-btn b-btn-secondary text-decoration-none">
                Limpiar
            </a>
        </section>
    </form>
</section>

<section class="b-card p-0 overflow-hidden sales-history-card mb-4">
    <header class="p-3 sales-history-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <section>
            <strong style="font-family: var(--font-display); text-transform: uppercase;">Centro de comprobantes</strong>
            <p class="mb-0 text-muted" style="font-family: var(--font-mono); font-size: 0.88rem;">@Model.GetFilterSummary()</p>
        </section>
        <button type="button" class="b-btn b-btn-secondary" data-bs-toggle="modal" data-bs-target="#salesListingReportModal">
            <i class="bi bi-window"></i> Previsualizar listado
        </button>
    </header>
    <section class="table-responsive sales-history-table-wrap">
        <table class="table table-hover align-middle mb-0 products-table sales-history-table">
            <thead class="text-center">
                <tr>
                    <th class="sortable-header text-center fw-bold" title="Ordenar por Código">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="code" asp-route-sortDirection="@Model.GetNextSortDirection("code")" class="sort-button text-decoration-none">
                            Código <i class="bi @Model.GetSortIcon("code")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="sortable-header text-center fw-bold" title="Ordenar por Fecha/Hora">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="createdat" asp-route-sortDirection="@Model.GetNextSortDirection("createdat")" class="sort-button text-decoration-none">
                            Fecha/Hora <i class="bi @Model.GetSortIcon("createdat")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="sortable-header text-center fw-bold" title="Ordenar por Cliente">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="customer" asp-route-sortDirection="@Model.GetNextSortDirection("customer")" class="sort-button text-decoration-none">
                            Cliente <i class="bi @Model.GetSortIcon("customer")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="sortable-header text-center fw-bold" title="Ordenar por Método">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="paymentmethod" asp-route-sortDirection="@Model.GetNextSortDirection("paymentmethod")" class="sort-button text-decoration-none">
                            Método <i class="bi @Model.GetSortIcon("paymentmethod")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="sortable-header text-end fw-bold" title="Ordenar por Total">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="total" asp-route-sortDirection="@Model.GetNextSortDirection("total")" class="sort-button text-decoration-none">
                            Total <i class="bi @Model.GetSortIcon("total")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="sortable-header text-center fw-bold" title="Ordenar por Estado">
                        <a asp-page="/Sales/Reports" asp-route-businessDate="@businessDateValue" asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue" asp-route-statusFilter="@Model.StatusFilter" asp-route-paymentMethodFilter="@Model.PaymentMethodFilter" asp-route-sortBy="status" asp-route-sortDirection="@Model.GetNextSortDirection("status")" class="sort-button text-decoration-none">
                            Estado <i class="bi @Model.GetSortIcon("status")" style="font-size: 0.8em;"></i>
                        </a>
                    </th>
                    <th class="text-center products-actions-col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentSales.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No existen ventas para los filtros seleccionados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var sale in Model.RecentSales)
                    {
                        <tr>
                            <td class="fw-bold" style="font-family: var(--font-mono);">@sale.Code</td>
                            <td style="font-family: var(--font-mono);">@sale.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@sale.CustomerName</td>
                            <td>@sale.PaymentMethod</td>
                            <td class="text-end fw-bold" style="font-family: var(--font-mono);">@sale.Total.ToString("N2") Bs.</td>
                            <td class="text-center">
                                @if (string.Equals(sale.Status, "Anulada", StringComparison.Ordinal))
                                {
                                    <mark class="status-badge" data-status="danger">@sale.Status</mark>
                                }
                                else
                                {
                                    <mark class="status-badge" data-status="success">@sale.Status</mark>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <a asp-page="/Sales/Detail" asp-route-saleId="@sale.Id" class="b-btn b-btn-secondary" style="padding: 0.25rem 0.5rem;" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="/Sales/Receipt" asp-route-saleId="@sale.Id" target="_blank" rel="noopener noreferrer" class="b-btn b-btn-secondary" style="padding: 0.25rem 0.5rem;" title="Ver comprobante">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
</section>

<section class="modal fade reports-preview-modal" id="salesListingReportModal" tabindex="-1" aria-labelledby="salesListingReportModalLabel" aria-hidden="true">
    <section class="modal-dialog modal-dialog-centered modal-dialog-scrollable reports-preview-dialog">
        <article class="modal-content">
            <header class="modal-header">
                <h5 class="modal-title" id="salesListingReportModalLabel" style="font-family: var(--font-display); font-weight: 800;">
                    <i class="bi bi-list-check me-2"></i>Reporte de ventas
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </header>
            <section class="modal-body p-0">
                <section class="reports-print-area">
                    <section class="b-card b-card-static p-4">
                        <header class="reports-document-heading d-flex justify-content-between align-items-start gap-3 pb-3 mb-4">
                            <section class="d-flex align-items-center gap-3">
                                <img src="~/favicon.svg" alt="Mercadito" class="reports-logo" />
                                <section>
