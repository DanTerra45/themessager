@page "/ChangePassword"
@model ServicioFrontend.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="mx-auto" style="max-width: 520px;">
    <header class="dash-header mb-4">
        <section>
            <h1>CAMBIAR CONTRASEÑA</h1>
            @if (Model.IsForcedChange)
            {
                <p class="mb-0 text-muted" style="font-family: var(--font-mono);">Actualización obligatoria de acceso</p>
            }
            else
            {
                <p class="mb-0 text-muted" style="font-family: var(--font-mono);">Actualiza tu clave de acceso de forma segura</p>
            }
        </section>
    </header>

    <section class="b-card b-card-static p-4">
        <form method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <section class="mb-3">
                <label class="form-label fw-bold">Usuario</label>
                <input class="form-control readonly-display-input" value="@Model.Username" readonly />
                @if (Model.IsForcedChange)
                {
                    <small class="text-muted d-block mt-1">Debes definir una nueva contraseña antes de continuar.</small>
                }
                else
                {
                    <small class="text-muted d-block mt-1">Para cambiar tu contraseña debes confirmar la contraseña actual.</small>
                }
            </section>

            <section class="mb-3">
                <label class="form-label fw-bold">Rol</label>
                <input class="form-control readonly-display-input" value="@(string.IsNullOrWhiteSpace(Model.Role) ? "Sin rol asignado" : Model.Role)" readonly />
            </section>

            <section class="mb-3">
                <label asp-for="PasswordChange.CurrentPassword" class="form-label fw-bold">
                    Contraseña actual
                    <span asp-validation-for="PasswordChange.CurrentPassword" class="validation-icon-inline"></span>
                </label>
                <input asp-for="PasswordChange.CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="PasswordChange.CurrentPassword" class="text-danger small d-block mt-1"></span>
            </section>

            <section class="mb-3">
                <label asp-for="PasswordChange.NewPassword" class="form-label fw-bold">
                    Nueva contraseña
                    <span asp-validation-for="PasswordChange.NewPassword" class="validation-icon-inline"></span>
                </label>
                <input asp-for="PasswordChange.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <small class="text-muted d-block mt-1">Debe tener entre 8 y 128 caracteres, con mayúscula, minúscula y número.</small>
                <span asp-validation-for="PasswordChange.NewPassword" class="text-danger small d-block mt-1"></span>
            </section>

            <section class="mb-3">
                <label asp-for="PasswordChange.ConfirmPassword" class="form-label fw-bold">
                    Confirmar contraseña
                    <span asp-validation-for="PasswordChange.ConfirmPassword" class="validation-icon-inline"></span>
                </label>
                <input asp-for="PasswordChange.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordChange.ConfirmPassword" class="text-danger small d-block mt-1"></span>
            </section>

            <footer class="d-flex justify-content-end gap-2">
                <button type="submit" class="b-btn">Actualizar contraseña</button>
            </footer>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
